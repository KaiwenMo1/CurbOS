{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CurbOS offline CDS capture manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_schema_version", "scope_key", "publisher_key", "dataset_key",
    "catalog_uri", "source_profile", "adapter_version", "source_profile_version",
    "declared_captured_at_utc", "rights_status", "components"
  ],
  "properties": {
    "manifest_schema_version": {"const": 1},
    "scope_key": {"anyOf": [{"$ref": "#/$defs/key"}, {"type": "null"}]},
    "publisher_key": {"$ref": "#/$defs/key"},
    "dataset_key": {"$ref": "#/$defs/key"},
    "catalog_uri": {"type": "string", "minLength": 1, "maxLength": 2048},
    "source_profile": {"$ref": "#/$defs/key"},
    "adapter_version": {"$ref": "#/$defs/key"},
    "source_profile_version": {"$ref": "#/$defs/key"},
    "declared_captured_at_utc": {"$ref": "#/$defs/utc"},
    "rights_status": {"enum": ["UNKNOWN", "REVIEW_REQUIRED"]},
    "rights_reference": {"type": ["string", "null"], "maxLength": 2048},
    "components": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/component"}
    }
  },
  "$defs": {
    "key": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,100}$"},
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"},
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "relative_path", "sha256", "byte_size", "original_source_uri", "source_format"],
      "properties": {
        "role": {"enum": ["zones", "policies", "areas"]},
        "relative_path": {"type": "string", "minLength": 1, "maxLength": 1024},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "maxLength": 64},
        "byte_size": {"type": "integer", "minimum": 1, "maximum": 134217728},
        "original_source_uri": {"type": "string", "minLength": 1, "maxLength": 2048},
        "source_format": {"const": "json"},
        "source_crs": {"type": ["string", "null"], "maxLength": 64},
        "source_as_of": {"anyOf": [{"$ref": "#/$defs/utc"}, {"type": "null"}]},
        "timestamp_unit": {"enum": ["seconds", "milliseconds", null]}
      }
    }
  }
}
