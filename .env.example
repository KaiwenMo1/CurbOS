# Copy to .env and set a unique local password before starting PostgreSQL.
POSTGRES_PASSWORD=
# Host port published on 127.0.0.1 only.
CURBOS_DB_PORT=5432

# Export these for the API process. Go does not load .env automatically.
# Set an explicit PostgreSQL URL. Use PGPASSWORD for the local password.
CURBOS_DATABASE_URL=
CURBOS_HTTP_ADDR=127.0.0.1:8080
CURBOS_READY_TIMEOUT=1s
CURBOS_SHUTDOWN_TIMEOUT=10s
